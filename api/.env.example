APP_NAME=MCP Guard
ENVIRONMENT=dev
# seed_dev.py refuses to run when APP_ENV=production.
APP_ENV=dev
CORS_ORIGINS=["http://localhost:5173"]
MCP_SELF_URL=http://127.0.0.1:8000/mcp/

# Optional. When unset, the database file is api/data/mcp_guard.db
# resolved from the package directory, not the process working directory.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/mcp_guard.db

# Optional. When unset, notes are stored in api/data/notes.
NOTES_DIR=data/notes

# Maximum HTTP request body size in bytes. Default is 1 MiB.
MAX_BODY_BYTES=1048576

# MCP tool invocation timeout in seconds. Default is 5.
TOOL_TIMEOUT_S=5
