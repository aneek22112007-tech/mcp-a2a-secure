APP_NAME=MCP Guard
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:5173"]
# TRUSTED_PROXIES=[]  # JSON list of trusted proxy IPs or CIDRs, e.g. ["10.0.0.1","172.16.0.0/12"]
# HSTS_MAX_AGE_S=0    # Set to 31536000 to enable Strict-Transport-Security for one year
# AUTH_FAILURE_LIMIT=20         # Failed 401 attempts per IP before throttling
# AUTH_FAILURE_WINDOW_S=60      # Fixed window in seconds for the failed-auth counter
# AUTH_FAILURE_MAX_TRACKED_IPS=10000  # LRU cap for the throttle table
MCP_SELF_URL=http://127.0.0.1:8000/mcp/
# MCP_SELF_API_KEY=  # mcpg_ key with agent:run, used only by /api/status self-probe
# DATABASE_URL=sqlite+aiosqlite:///data/mcp_guard.db
API_KEY_PEPPER=replace-with-a-local-development-secret

# Optional. When unset, notes are stored in api/data/notes.
NOTES_DIR=data/notes

# Maximum HTTP request body size in bytes. Default is 1 MiB.
MAX_BODY_BYTES=1048576

# MCP tool invocation timeout in seconds. Default is 5.
TOOL_TIMEOUT_S=5

# Sandbox. inprocess is for local development only. Production refuses it.
SANDBOX_MODE=inprocess
# SANDBOX_IMAGE=mcp-guard-tool-runner:local
# SANDBOX_TIMEOUT_S=4
# SANDBOX_MEMORY=128m
# SANDBOX_CPUS=0.5
# SANDBOX_PIDS_LIMIT=64
# SANDBOX_MAX_FILE_BYTES=1048576
# SANDBOX_MAX_OUTPUT_BYTES=1048576
# SANDBOX_MAX_CONCURRENT=4
# SANDBOX_NETWORK=none
# SANDBOX_RUN_AS=65534:65534
# SANDBOX_NOTES_SOURCE=
# SANDBOX_DOCKER_BIN=docker

# Maximum concurrent subscribers for GET /api/audit/stream. Default is 20.
# AUDIT_STREAM_MAX_SUBSCRIBERS=20

# Per-subscriber queue size for the audit SSE stream. Default is 100.
# AUDIT_STREAM_QUEUE_SIZE=100

# Token bucket capacity for rate limiting. Default is 100.
# RATE_LIMIT_CAPACITY=100

# Token bucket refill rate per second for rate limiting. Default is 10.0.
# RATE_LIMIT_REFILL_RATE_PER_SEC=10.0

# Number of days to retain audit log events. Default is 90.
# AUDIT_RETENTION_DAYS=90

# Enable automatic cleanup of old audit records via a background task. Default is False.
# ENABLE_RETENTION_SCHEDULER=False

# Number of days to retain sandbox runs. Default is 90.
# SANDBOX_RUN_RETENTION_DAYS=90

# Tool schema pinning. off skips the check. warn audits and continues.
# enforce returns 403 until an admin approves the live fingerprint.
# TOOL_PINNING_MODE=off

# Approve every current tool at startup. Rejected in a production-like environment.
# TOOL_PINNING_BOOTSTRAP_APPROVE=false

# Seconds to cache pin rows. Approve, revoke, and sync clear the cache.
# TOOL_PINNING_CACHE_TTL_S=5

# Static Tool Scanner
# SCANNER_ENABLED=true
# SCANNER_RUN_ON_STARTUP=true
# SCANNER_BLOCK_SEVERITIES=critical,high
