# ==============================================================================
# MCP Guard — Docker Compose Environment Configuration Template
# ==============================================================================
# Copy this file to .env at the repository root for Docker Compose:
#   cp .env.compose.example .env
#
# IMPORTANT: The credentials below are DEVELOPMENT DEFAULTS only.
# Never use these default credentials or peppers in production.

# ------------------------------------------------------------------------------
# PostgreSQL Database Service
# ------------------------------------------------------------------------------
POSTGRES_DB=mcpg_guard
POSTGRES_USER=mcpg_user
POSTGRES_PASSWORD=mcpg_dev_password
POSTGRES_PORT=5432

# Async connection string used by the API container and Alembic
DATABASE_URL=postgresql+asyncpg://mcpg_user:mcpg_dev_password@postgres:5432/mcpg_guard

# ------------------------------------------------------------------------------
# API Service Configuration
# ------------------------------------------------------------------------------
APP_NAME=MCP Guard
ENVIRONMENT=dev
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Pepper secret for hashing API keys (development-only placeholder)
API_KEY_PEPPER=mcpg_dev_pepper_do_not_use_in_production_32bytes!

# ------------------------------------------------------------------------------
# Storage & Docker Named Volumes
# ------------------------------------------------------------------------------
# Notes directory inside container and Docker volume source for tool runner
NOTES_DIR=/app/data/notes
SANDBOX_NOTES_SOURCE=volume:mcpg_notes

# Filesystem upstream MCP server configuration using named volume
UPSTREAM_FS_ENABLED=true
UPSTREAM_FS_IMAGE=mcp-guard-upstream-fs:2.2.0
UPSTREAM_FS_DIR=/app/data/shared
UPSTREAM_FS_SOURCE=volume:mcpg_shared
UPSTREAM_FS_TIMEOUT_S=30.0

# ------------------------------------------------------------------------------
# Sandbox Execution Configuration
# ------------------------------------------------------------------------------
SANDBOX_MODE=docker
SANDBOX_IMAGE=mcp-guard-tool-runner:local
SANDBOX_TIMEOUT_S=4
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_NETWORK=none
SANDBOX_RUN_AS=65534:65534

# ------------------------------------------------------------------------------
# Gateway Hardening & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_RATE_PER_SEC=5.0
INJECTION_GUARD_MODE=warn
TOOL_PINNING_MODE=enforce
