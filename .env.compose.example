# ==============================================================================
# MCP Guard — Docker Compose Environment Configuration Template
# ==============================================================================
# Copy this file to .env at the repository root for Docker Compose:
#   cp .env.compose.example .env
#
# IMPORTANT:
# - POSTGRES_PASSWORD, API_KEY_PEPPER and REDIS_PASSWORD are REQUIRED.
#   Compose will refuse to render or start if they are missing or unset.
# - The placeholder values below MUST be replaced with strong, uniquely
#   generated secrets before deployment. Never commit your .env file.
# - Compose ignores DATABASE_URL. It builds the API URL from POSTGRES_USER,
#   POSTGRES_PASSWORD and POSTGRES_DB. POSTGRES_PASSWORD is placed in that
#   URL, so keep it hex: openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Service
# ------------------------------------------------------------------------------
POSTGRES_DB=mcpg_guard
POSTGRES_USER=mcpg_user
# REQUIRED: hex password (openssl rand -hex 32). It is embedded in the API URL.
POSTGRES_PASSWORD=change-me
# Optional host port mapping for local database debugging (disabled by default)
POSTGRES_PORT=5432

# REQUIRED: Valkey password (openssl rand -hex 32). Compose refuses to start without it.
REDIS_PASSWORD=change-me-redis

# ------------------------------------------------------------------------------
# API Service Configuration
# ------------------------------------------------------------------------------
APP_NAME=MCP Guard
# API_PORT is the proxy's host port. The API replicas are not published.
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# Origin Caddy adds to connect-src for the separate sign-in service.
SIGNIN_API_ORIGIN=http://localhost:5001

# REQUIRED: Replace placeholder with a cryptographically secure random pepper (at least 32 bytes)
API_KEY_PEPPER=change-me-to-a-long-random-value

# ------------------------------------------------------------------------------
# Gateway Hardening & Security Policies
# ------------------------------------------------------------------------------
# Gateway policy enforcement: "off", "warn", or "enforce"
INJECTION_GUARD_MODE=enforce
TOOL_PINNING_MODE=enforce
ENABLE_RETENTION_SCHEDULER=true

# ------------------------------------------------------------------------------
# Rate Limiting (Token Bucket)
# ------------------------------------------------------------------------------
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_RATE_PER_SEC=5.0

# ------------------------------------------------------------------------------
# Docker Sandbox Tool Runner
# ------------------------------------------------------------------------------
SANDBOX_MODE=docker
SANDBOX_MAX_CONCURRENT=3
SANDBOX_IMAGE=mcp-guard-tool-runner:local
SANDBOX_TIMEOUT_S=4
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_NETWORK=none
SANDBOX_RUN_AS=65534:65534

# ------------------------------------------------------------------------------
# Filesystem Upstream MCP Server
# ------------------------------------------------------------------------------
UPSTREAM_FS_IMAGE=mcp-guard-upstream-fs:2.2.0
UPSTREAM_FS_TIMEOUT_S=30.0

# ------------------------------------------------------------------------------
# LLM & Agent Integration (Optional)
# ------------------------------------------------------------------------------
LLM_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional provider keys (leave empty if unused)
GROQ_API_KEY=
NOTES_AGENT_API_KEY=
WORKER_NOTES_API_KEY=
