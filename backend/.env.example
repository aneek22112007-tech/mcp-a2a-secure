# ============================================================
#  MCP-A2A-Secure  —  Backend Environment Variables Example
#  Rename this file to .env and fill in your own values
# ============================================================

# --- Server ---
PORT=5001

# --- JWT ---
# Generate a random string for this (e.g., using `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`)
JWT_SECRET=your_jwt_secret_here

# --- Google OAuth 2.0 ---
# Client ID — get this from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Client Secret — get this from Google Cloud Console
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
